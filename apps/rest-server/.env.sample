PORT=3000
NPM_CONFIG_PRODUCTION=false

# Possible values (in order): debug, info, warn, error, critical
LOGGER_LEVEL=info

OPEN_API_SCHEMA_VISIBLE=true
ERROR_DETAILS_VISIBLE=true

# Comma-separated origins allowed to call the API from a browser (the web app's dev server)
CORS_ORIGINS=http://localhost:4000
