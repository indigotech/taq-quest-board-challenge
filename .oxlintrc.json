{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "apps/web/src/atomic/**",
    "apps/web/.storybook/**",
    "!apps/web/src/atomic/obj.modal/",
    "apps/web/src/atomic/obj.modal/*",
    "!apps/web/src/atomic/obj.modal/modal.component.tsx",
    "!apps/web/src/atomic/obj.modal/modal.component.style.tsx",
    "!apps/web/src/atomic/obj.form/",
    "apps/web/src/atomic/obj.form/*",
    "!apps/web/src/atomic/obj.form/field.component.styled.tsx",
    "!apps/web/src/atomic/atm.button/",
    "apps/web/src/atomic/atm.button/*",
    "!apps/web/src/atomic/atm.button/button.component.style.tsx",
    "!apps/web/src/atomic/atm.typography/",
    "apps/web/src/atomic/atm.typography/*",
    "!apps/web/src/atomic/atm.typography/typography.component.style.tsx"
  ],
  "rules": {
    "curly": "error",
    "no-console": ["warn", { "allow": ["error"] }],
    "no-else-return": "warn",
    "no-param-reassign": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": ["@repo/*/test", "#test/*"]
      }
    ],
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "typescript/no-explicit-any": "off",
    "typescript/no-extraneous-class": "off",
    "typescript/no-non-null-assertion": "off",
    "unicorn/no-array-for-each": "off"
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
